<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- App Title (stays consistent across screens) -->
    <TextView
        android:id="@+id/txtAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Weight Tracking App"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Holds all UI "screens" -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right"
        app:layout_constraintTop_toBottomOf="@id/txtAppTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ==========================
             SCREEN 0: LOGIN / CREATE ACCOUNT
             ========================== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter your username and password to continue."
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <EditText
                    android:id="@+id/edtUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    android:inputType="textPersonName"
                    android:importantForAutofill="yes" />

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:importantForAutofill="yes"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/txtLoginStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:paddingTop="12dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- ==========================
             SCREEN 1: DASHBOARD (hub)
             Includes: add weight, set goal, navigation
             ========================== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/txtWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <!-- Progress / summary section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:background="#EEEEEE">

                    <TextView
                        android:id="@+id/txtCurrentWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current Weight: —" />

                    <TextView
                        android:id="@+id/txtGoalWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Goal Weight: —"
                        android:paddingTop="6dp" />

                    <TextView
                        android:id="@+id/txtProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Progress: —"
                        android:paddingTop="6dp" />
                </LinearLayout>

                <!-- Add Daily Weight section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Daily Weight"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <EditText
                    android:id="@+id/edtDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date (e.g., 2026-02-04)"
                    android:inputType="text"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Weight (lbs)"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnAddEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add to History"
                    android:layout_marginTop="10dp" />

                <!-- Set Goal section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Goal Weight"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/edtGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Goal weight (lbs)"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnSaveGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Goal"
                    android:layout_marginTop="10dp" />

                <!-- Navigation -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Navigate"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btnGoHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View History (Grid)"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnGoSms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Notifications"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtDashboardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:paddingTop="12dp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- ==========================
             SCREEN 2: HISTORY GRID (RecyclerView) + headers + per-row delete concept
             ========================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="History (Grid)"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- Headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Date"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weight"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Action"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:listitem="@android:layout/simple_list_item_2" />

            <!-- NEW: Add button on the History screen (rubric-proof) -->
            <Button
                android:id="@+id/btnAddFromHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Entry"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnBackFromHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Dashboard"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- ==========================
             SCREEN 3: SMS PERMISSION SCREEN
             ========================== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Notifications"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This app can send SMS notifications when you reach your goal weight. You can allow or deny permission. If you deny, the app still works, but you will not receive SMS notifications."
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btnCheckSmsPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable / Check SMS Permission" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone Number (for SMS)"
                    android:textStyle="bold"
                    android:paddingTop="12dp" />

                <EditText
                    android:id="@+id/edtPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., 15551234567"
                    android:inputType="phone"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnSavePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Phone Number"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/txtSmsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Permission Status: Unknown"
                    android:textStyle="bold"
                    android:paddingTop="12dp" />

                <Button
                    android:id="@+id/btnBackFromSms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Dashboard"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
